# Copiar como .env y cambiar las contraseñas antes de desplegar.
FRONT_PORT=8080
MYSQL_DATABASE=DB
MYSQL_USER=app_user
MYSQL_PASSWORD=change-this-app-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Intervalos en segundos; retención en días.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
CHECK_INTERVAL_SECONDS=3600# Credenciales solo para desarrollo local: cámbialas antes de publicar el servicio.
MYSQL_ROOT_PASSWORD=dev-root-change-this
MYSQL_DATABASE=DB
MYSQL_USER=app
MYSQL_PASSWORD=dev-app-change-this
APP_PORT=8080

# Para publicar la imagen, cambia el valor por una etiqueta de tu registro.
# Ejemplo: ghcr.io/tu-usuario/sigeru-api:1.0
APP_IMAGE=sigeru/api:local

# Para compose.deploy.yaml: base de datos ya instalada y accesible desde el host.
DB_HOST=nombre-o-ip-del-servidor-mysql
DB_PORT=3306
DB_NAME=DB
DB_USER=app
DB_PASSWORD=dev-app-change-this
