#detalle de comentarios:
#!inicio de grupo
#¡fin de un grupo
#-subgrupo
#*modificar
#comentario normal

Options +FollowSymLinks
RewriteEngine On
RewriteBase /GIT/api/

#!GRUPO API DE USUARIO.
#-API POR TIPO
RewriteRule ^user/adminsys(/.*)?$ apis/users_api/API_AdminSys.php [L,QSA]
RewriteRule ^user/vecino(/.*)?$ apis/users_api/API_Vecino.php [L,QSA]
RewriteRule ^user/operador(/.*)?$ apis/users_api/API_Operador.php [L,QSA]
RewriteRule ^user/adminoperador(/.*)?$ apis/users_api/API_AdminOperador.php [L,QSA]
RewriteRule ^user/admingeneral(/.*)?$ apis/users_api/API_AdminGeneral.php [L,QSA]
RewriteRule ^borrar_datos(/.*)?$ apis/API_Teapot.php [L,QSA]

#-API DEFAULT USUARIO 
RewriteRule ^user/(.*)$ apis/users_api/API_DefaultUser.php [L,QSA]

